{
  "name": "@goatnetwork/mpp-middleware",
  "version": "0.1.0",
  "description": "MPP Payment-Receipt verification middleware for Express and Fastify",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "types": "./dist/express.d.ts"
    },
    "./fastify": {
      "import": "./dist/fastify.js",
      "types": "./dist/fastify.d.ts"
    }
  },
  "files": [
    "dist",
    "src/*.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/express-serve-static-core": "^4.19.0",
    "@types/node": "^20.10.0",
    "express": "^4.19.0",
    "fastify": "^4.28.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "goatx402",
    "mpp",
    "payment",
    "receipt",
    "middleware",
    "express",
    "fastify"
  ],
  "author": "",
  "license": "MIT"
}
