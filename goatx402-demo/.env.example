# GoatX402 Demo Configuration
# Copy this file to .env and fill in your values

# ===== Classic mode (existing GoatX402 order flow) =====
GOATX402_MERCHANT_ID=your_merchant_id_here
GOATX402_API_URL=http://localhost:8286
GOATX402_API_KEY=your_api_key_here
GOATX402_API_SECRET=your_api_secret_here

# Server port (optional)
PORT=3001

# ===== MPP mode (optional — leave blank to disable MPP tab) =====
# Core base URL the browser hits for /mpp/v1/{challenge,verify}.
# Must have CORS enabled for the demo origin (Core sets this via
# mpp.cors.allowed_origins or the MPP_API_ALLOWED_ORIGINS env var).
# MPP_CORE_URL=http://localhost:8080

# Merchant_id that has been bootstrapped with admin /mpp/enable
# and at least one mpp/routes entry whose route_canonical matches
# MPP_ROUTE_CANONICAL below.
# MPP_MERCHANT_ID=test-merchant-1

# Route canonical. Must match Core's regex ^[A-Za-z0-9._:~-]{1,200}$
# — no slashes, spaces, or fragments. Default mirrors the demo plan.
# MPP_ROUTE_CANONICAL=GET:api:mpp:protected

# Optional buyer-facing payment choices for the MPP tab. When omitted,
# the demo discovers active merchant MPP routes from Core:
#   GET $MPP_CORE_URL/merchants/$MPP_MERCHANT_ID/mpp/routes
# If Core route discovery returns no active routes, the demo falls back
# to one default option using MPP_ROUTE_CANONICAL.
# MPP_ROUTE_OPTIONS='[
#   {
#     "id": "basic",
#     "label": "Basic article",
#     "description": "One paid protected API response",
#     "routeCanonical": "GET:api:mpp:protected:basic",
#     "amount": "0.10",
#     "token": "USDC",
#     "chainId": 42431
#   },
#   {
#     "id": "pro",
#     "label": "Pro report",
#     "description": "Higher-priced merchant route",
#     "routeCanonical": "GET:api:mpp:protected:pro",
#     "amount": "1.00",
#     "token": "USDC",
#     "chainId": 42431
#   }
# ]'

# Receipt verifier algorithm + key.
# - For ed25519 (recommended): MPP_RECEIPT_KEY_HEX is the 32-byte
#   public key (hex) derived from Core's 64-byte ed25519 private key.
#   Either copy from the admin UI's "Receipt verifier public key"
#   card or derive it from the second half of Core's ed25519 private key.
# - For hmac-sha256 (single-tenant dev only): MPP_RECEIPT_KEY_HEX is
#   the shared secret (>= 32 bytes hex), the SAME bytes configured on
#   Core's mpp.receipt_signing.hmac_secret_*.
# MPP_RECEIPT_ALG=ed25519
# MPP_RECEIPT_KEY_HEX=
