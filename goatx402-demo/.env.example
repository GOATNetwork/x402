# GOAT Flow Demo Configuration
# Copy this file to .env and fill in your values

# ===== Classic mode (existing GOAT Flow order flow) =====
GOATX402_MERCHANT_ID=your_merchant_id_here
GOATX402_API_URL=http://localhost:8286
GOATX402_API_KEY=your_api_key_here
GOATX402_API_SECRET=your_api_secret_here

VITE_QUICKPAY_MERCHANT=test-merchant-1
VITE_QUICKPAY_PRODUCT=mug

# Server port (optional)
PORT=3001

# ===== DELEGATE hosted checkout (optional — leave blank to hide the button) =====
# Config-gated example of a server-authoritative DELEGATE (TSS/Permit2/EIP-3009)
# hosted checkout. The backend mints a session via the server SDK and the
# Checkout SDK tab redirects the buyer to the hosted page by handle.
#
# A runnable DELEGATE flow needs a deployed/approved MerchantCallback contract
# and DELEGATE merchant API keys (the GOATX402_API_KEY / GOATX402_API_SECRET
# above must belong to that merchant). Core derives the callback chain and payable
# source-chain/token candidates from merchant configuration. This one flag makes
# the demo's server-priced DELEGATE catalog visible.
# DELEGATE_ENABLED=1
# DELEGATE_SUCCESS_URL=https://your.app/success   # optional, allowlist-gated by the hosted page
# DELEGATE_CANCEL_URL=https://your.app/cancel     # optional, allowlist-gated by the hosted page

# ===== MPP mode (optional — leave blank to disable MPP tab) =====
# Core base URL the browser hits for /mpp/v1/{challenge,verify}.
# Must have CORS enabled for the demo origin (Core sets this via
# mpp.cors.allowed_origins or the MPP_API_ALLOWED_ORIGINS env var).
# MPP_CORE_URL=http://localhost:8080

# Merchant_id that has been bootstrapped with admin /mpp/enable and at
# least one active mpp/routes entry (the demo discovers routes from Core).
# MPP_MERCHANT_ID=test-merchant-1

# Optional buyer-facing payment choices for the MPP tab. When omitted,
# the demo discovers active merchant MPP routes from Core:
#   GET $MPP_CORE_URL/merchants/$MPP_MERCHANT_ID/mpp/routes
# If discovery returns no active routes, the demo FAILS LOUD (no phantom
# default route — that would 404 at the challenge step); create a route in
# the admin MPP page, or set MPP_ROUTE_OPTIONS below to override.
# MPP_ROUTE_OPTIONS='[
#   {
#     "id": "basic",
#     "label": "Basic article",
#     "description": "One paid protected API response",
#     "routeCanonical": "GET:api:mpp:protected:basic",
#     "amount": "0.10",
#     "token": "USDC",
#     "chainId": 42431
#   },
#   {
#     "id": "pro",
#     "label": "Pro report",
#     "description": "Higher-priced merchant route",
#     "routeCanonical": "GET:api:mpp:protected:pro",
#     "amount": "1.00",
#     "token": "USDC",
#     "chainId": 42431
#   }
# ]'

# Receipt verifier algorithm + key.
# - For ed25519 (recommended): MPP_RECEIPT_KEY_HEX is the 32-byte
#   public key (hex) derived from Core's 64-byte ed25519 private key.
#   Either copy from the admin UI's "Receipt verifier public key"
#   card or use the derivation snippet in this module's README.
# - For hmac-sha256 (single-tenant dev only): MPP_RECEIPT_KEY_HEX is
#   the shared secret (>= 32 bytes hex), the SAME bytes configured on
#   Core's mpp.receipt_signing.hmac_secret_*.
# MPP_RECEIPT_ALG=ed25519
# MPP_RECEIPT_KEY_HEX=
