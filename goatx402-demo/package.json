{
  "name": "goatflow-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:local-deps": "pnpm --dir ../goatx402-sdk-server-ts install --frozen-lockfile && pnpm --dir ../goatx402-sdk-server-ts build && pnpm --dir ../goatx402-sdk install --frozen-lockfile && pnpm --dir ../goatx402-sdk build && pnpm --dir ../goatx402-mpp-middleware-ts install --frozen-lockfile && pnpm --dir ../goatx402-mpp-middleware-ts build && pnpm --dir ../goatx402-checkout install --frozen-lockfile && pnpm --dir ../goatx402-checkout build",
    "predev": "pnpm run build:local-deps",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "prebuild": "pnpm run build:local-deps",
    "build": "tsc && vite build",
    "prebuild:server": "pnpm run build:local-deps",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "goatflow-sdk": "link:../goatx402-sdk",
    "goatflow-checkout": "link:../goatx402-checkout",
    "goatflow-sdk-server": "link:../goatx402-sdk-server-ts",
    "@goatnetwork/mpp-middleware": "link:../goatx402-mpp-middleware-ts",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ethers": "^6.9.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
