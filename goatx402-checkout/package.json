{
  "name": "goatflow-checkout",
  "version": "0.1.0",
  "description": "GOAT Flow drop-in browser SDK for unified DIRECT and DELEGATE hosted checkout",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GOATNetwork/x402.git",
    "directory": "goatx402-checkout"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "unpkg": "dist/checkout.global.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-iife.mjs",
    "build:iife": "node scripts/build-iife.mjs",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run test:run",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "goatflow",
    "goatx402",
    "quickpay",
    "checkout",
    "x402",
    "payment",
    "sdk"
  ],
  "license": "MIT"
}
