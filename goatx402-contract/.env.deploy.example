# Copy to .env.deploy (gitignored) and fill in. Used by deploy-merchant-callback.sh.
# Your private key stays on YOUR machine — it is never printed or sent anywhere.

# REQUIRED — deployer key (0x-prefixed). This address becomes the MerchantCallback OWNER.
# Fund it with a little gas first (tBNB on BSC Testnet).
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# OPTIONAL — the target environment's x402d "Bob" caller to authorize (setAuthorizedCaller).
# Get this from the platform admin/operator (it is NOT public). If left blank the
# script deploys + prints the proxy but skips authorization; run it later by hand.
X402_CALLER_ADDRESS=

# OPTIONAL — only needed for on-chain source verification (--verify on bscscan).
ETHERSCAN_API_KEY=

# OPTIONAL — chain/RPC. Defaults below target BSC Testnet. Other foundry.toml aliases:
# sepolia (11155111), metis_sepolia (59902), goat_testnet3 (48816).
RPC_ALIAS=bsc_testnet
CHAIN_ID=97
